# mssql, postgres oder duckdb
SQLPROFIL_DIALECT=mssql

# --- SQL Server: Windows-Authentifizierung des angemeldeten Benutzers, kein Passwort ---
MSSQL_SERVER=sqlserver01.example.local
MSSQL_DATABASE=MeineDB
# Bei internem Zertifikat ohne vertrauenswuerdige CA: yes
MSSQL_TRUST_SERVER_CERT=no

# --- PostgreSQL: Standardvariablen von libpq (Passwort am besten ueber pgpass oder PGPASSWORD) ---
# PGHOST=localhost
# PGPORT=5432
# PGDATABASE=meinedb
# PGUSER=leser

# --- DuckDB: Datei (wird schreibgeschuetzt geoeffnet) oder :memory: mit Init-Skript ---
# SQLPROFIL_DSN=daten/meine.duckdb
# Init-Skript fuer :memory:, z. B. Views auf Parquet/CSV oder ATTACH einer SQLite-Datei
# SQLPROFIL_DUCKDB_INIT=duckdb_init.sql

# Optional fuer mssql und postgres: kompletter Connection String, ueberschreibt alles oben
# SQLPROFIL_DSN=Server=...;Database=...;Trusted_Connection=yes;Encrypt=yes;ApplicationIntent=ReadOnly
# SQLPROFIL_DSN=postgresql://leser@localhost:5432/meinedb

# --- Modell ueber LiteLLM ---
# Beispiele: azure/gpt-4.1 | openai/gpt-4.1 | anthropic/claude-sonnet-4-5 | ollama_chat/llama3.1
SQLPROFIL_MODEL=
# Nur bei LiteLLM-Proxy oder eigenem Endpunkt:
# SQLPROFIL_API_BASE=https://litellm.example.local
# SQLPROFIL_API_KEY=
# Provider-Keys liest LiteLLM selbst, z. B. AZURE_API_KEY, AZURE_API_BASE, AZURE_API_VERSION

# --- Chat ---
# patch  = der Chat aendert keine Dateien, sondern gibt am Ende einen lesbaren Patch zum Kopieren aus
# direkt = der Chat schreibt sofort in tables/*.yaml (nur sinnvoll, wenn du selbst chattest)
SQLPROFIL_CHAT_MODE=patch

# --- Grenzen ---
SQLPROFIL_QUERY_TIMEOUT=60
# Freie SELECT-Abfragen im Chat. Standard: aus, weil dann Rohzeilen ans Modell gehen.
SQLPROFIL_CHAT_SQL=off
SQLPROFIL_MAX_ROWS=100
# Wohin tables/, profiles/, reports/ geschrieben werden (Standard: ./daten, steht in .gitignore)
# SQLPROFIL_DATA_DIR=../meine-datenqualitaet

# Demo-Modus: shop, rental oder utilities. Uebersteuert Datenbank und Datenverzeichnis.
# SQLPROFIL_DEMO=rental
